				},
				{
					"name": "Update Feed",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Updated Feed\",\n  \"content\": \"Updated content\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/feed/api/feeds/:id",
							"host": ["{{base_url}}"],
							"path": ["feed", "api", "feeds", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "",
									"description": "Feed ID to update"
								}
							]
						},
						"description": "Update an existing feed post"
					}
				},
				{
					"name": "Delete Feed",
					"request": {
						"method": "DELETE",
						"header": [],
