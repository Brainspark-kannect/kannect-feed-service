			"name": "Feeds",
			"item": [
				{
					"name": "Get All Feeds",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/feed/api/feeds",
							"host": ["{{base_url}}"],
							"path": ["feed", "api", "feeds"]
						},
						"description": "Retrieve all feed posts"
					}
				},
				{
					"name": "Get Feed by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/feed/api/feeds/:id",
							"host": ["{{base_url}}"],
							"path": ["feed", "api", "feeds", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "",
									"description": "Feed ID"
								}
							]
						},
						"description": "Retrieve a feed post by its ID"
					}
				},
				{
					"name": "Get Fun Friday Feeds",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/feed/api/feeds/funfriday",
							"host": ["{{base_url}}"],
							"path": ["feed", "api", "feeds", "funfriday"]
						},
						"description": "Retrieve feed posts tagged as Fun Friday"
					}
				},
				{
					"name": "Create Feed",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "feed",
									"value": "{\n  \"title\": \"Sample Feed\",\n  \"content\": \"Feed content\"\n}",
									"type": "text",
									"description": "Feed data in JSON format"
								},
								{
									"key": "file",
									"type": "file",
									"description": "Optional media file"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/feed/api/feeds",
							"host": ["{{base_url}}"],
							"path": ["feed", "api", "feeds"]
						},
